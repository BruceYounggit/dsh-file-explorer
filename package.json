{
  "name": "@bruce_young/dsh-file-explorer",
  "version": "0.3.4",
  "description": "DeepSeek Harness plugin: a VSCode-like file tree for a remote SSH directory, with inline image and streaming video preview, drag-and-drop upload and file operations.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*",
    "cordis.patch.yml",
    "cordis.patch.example.yml",
    "file-explorer.example.json",
    "scripts/**/*",
    "docs/*.png",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "file-tree",
    "sftp",
    "ssh",
    "rclone",
    "video"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1"
  },
  "license": "MIT"
}
